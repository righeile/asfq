# Python environment.  Built by the launcher on first run from
# requirements.txt, so it is reproducible and has no business in the repo --
# it is also by far the largest thing in the folder.
.venv/
venv/
env/

# Byte-code and tooling caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Results.  Everything these hold is produced by a run and can be produced
# again; they are also where the actual specimen data ends up, which is the
# better reason to keep them out.
analysis_out/
batch_out/
notebook_out/
stitched/

# Generated by `python build_notebook.py` -- the generator is the source, the
# .ipynb is its output, and a committed copy would carry stored figures and
# numbers from whatever sections it was last run on.  Every notebook here is
# that kind of artefact, and `--out` can name them anything, so the rule is
# the extension rather than the one default name.  `git add -f` if you ever
# do want to track one.
*.ipynb

# Editor and assistant config, specific to one machine.
.claude/
.vscode/
.idea/

# Microscope data and exported images.  Nothing here belongs in a code repo,
# and a single .czi can be larger than everything else combined.  Remove a
# line if you deliberately want to track a small example.
*.czi
*.tif
*.tiff
*.nd2
*.lif
*.svs
*.png
*.jpg
*.jpeg
!static/**/*.png
!static/**/*.jpg
!labkit/static/**/*.png

# OS clutter.
.DS_Store
Thumbs.db
